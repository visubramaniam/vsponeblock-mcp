{
  "name": "vsponeblock-mcp",
  "version": "0.1.0",
  "description": "Community MCP server for Hitachi VSP One Block: the VSP One Block REST API (microcode 10.5.4) for Claude and other MCP clients. Not an official Hitachi Vantara product.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vsponeblock-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "spec",
    "INSTALL.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/cache-spec.mjs",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "eval": "npm run build && node tests/search-eval.mjs",
    "test": "npm run build && node --test \"tests/unit/*.test.mjs\" && node tests/search-eval.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "undici": "7.30.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@types/node": "22.18.8",
    "typescript": "5.9.3"
  },
  "author": "Vinod Subramaniam",
  "homepage": "https://github.com/visubramaniam/vsponeblock-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visubramaniam/vsponeblock-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/visubramaniam/vsponeblock-mcp/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "hitachi",
    "vsp-one-block",
    "vsp",
    "storage"
  ]
}
